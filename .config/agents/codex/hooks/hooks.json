{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/dotfiles/devbox/.config/codex/hooks/scripts/guard-tmp-output.sh",
						"timeout": 5,
						"statusMessage": "Checking temporary output policy"
					}
				]
			}
		]
	}
}
